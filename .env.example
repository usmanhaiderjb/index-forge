# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000

# Postgres. docker compose up -d gives you this exact URL.
DATABASE_URL=postgresql://aso:aso@localhost:5432/aso?schema=public

# Redis, used by BullMQ for sync jobs + rate limiting.
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Auth.js v5
#   AUTH_SECRET: openssl rand -base64 32
# ---------------------------------------------------------------------------
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Google sign-in (separate OAuth client from the data-scope client below).
# console.cloud.google.com > APIs & Services > Credentials > OAuth client ID (Web)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ---------------------------------------------------------------------------
# Encryption for stored third-party credentials (AES-256-GCM).
# Must be 32 bytes base64: openssl rand -base64 32
# Rotating this invalidates every stored connection token.
# ---------------------------------------------------------------------------
ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# AI engine (Anthropic)
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# Anthropic-compatible gateway (AgentRouter, a proxy, a self-hosted relay).
# Everything the AI features send — review text, listing metadata, app data —
# passes through whoever operates that endpoint.
#
# Set ANTHROPIC_AUTH_TOKEN *instead of* ANTHROPIC_API_KEY: gateways expect
# `Authorization: Bearer`, Anthropic expects `x-api-key`, and the wrong one
# returns a 401 that looks exactly like a bad key.
#
# The base URL takes no trailing path — agentrouter.org/v1 is the
# OpenAI-compatible endpoint and will not work with this client.
#
# The model names must be ones the gateway actually serves, and the set depends
# on the token. A gateway answers an unknown model with a 404 rather than
# falling back, so a name that is merely plausible fails at the first call.
# ANTHROPIC_AUTH_TOKEN=
# ANTHROPIC_BASE_URL=https://agentrouter.org
# ANTHROPIC_MODEL=claude-opus-5
# Bulk is the high-volume path — review classification for the Gap Finder runs
# thousands of short calls through it, so it wants the cheapest capable model
# the gateway offers rather than the default claude-sonnet-5.
# ANTHROPIC_MODEL_BULK=deepseek-v4-flash
# Default model for every AI feature.
ANTHROPIC_MODEL=claude-opus-5
# Used only for high-volume classification (per-review sentiment), where the
# job is thousands of short calls. Set this to ANTHROPIC_MODEL to use one model
# everywhere.
ANTHROPIC_MODEL_BULK=claude-sonnet-5
# low | medium | high | xhigh | max. Applies to the default model.
ANTHROPIC_EFFORT=high
# Monthly output-token ceiling per organization. 0 disables the cap.
AI_MONTHLY_TOKEN_BUDGET=2000000

# ---------------------------------------------------------------------------
# Google data integrations (Firebase, AdMob, Google Ads, Play Console).
# ONE OAuth client, many scopes. Requested incrementally per integration.
# Authorized redirect URI: http://localhost:3000/api/oauth/google/callback
# Required APIs to enable in the Cloud project:
#   - Firebase Management API, Google Analytics Data API (GA4 for Firebase)
#   - AdMob API
#   - Google Ads API
#   - Google Play Android Developer API
# ---------------------------------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Google Ads needs a developer token from your Google Ads manager account.
GOOGLE_ADS_DEVELOPER_TOKEN=
# Manager (MCC) account id, digits only, no dashes. Optional.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# ---------------------------------------------------------------------------
# Apple App Store Connect.
# Users supply these per-connection in the UI; these are only fallbacks
# for local development.
#   Issuer ID + Key ID + .p8 private key from App Store Connect > Users and
#   Access > Integrations > App Store Connect API.
# ---------------------------------------------------------------------------
APPLE_ASC_ISSUER_ID=
APPLE_ASC_KEY_ID=
APPLE_ASC_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# ASO data providers.
# The built-in provider uses public iTunes/Play endpoints and needs no key.
# Optional paid providers slot in behind the same interface.
# ---------------------------------------------------------------------------
ASO_PROVIDER=builtin
APPTWEAK_API_KEY=
SENSORTOWER_API_KEY=

# Outbound scraping identity + politeness. Keep the delay honest.
ASO_USER_AGENT=ASO-Dashboard/0.1 (+https://example.com/bot)
ASO_SCRAPE_DELAY_MS=1200
# Slower floor for the stores' search endpoints (itunes.apple.com,
# play.google.com), which throttle far sooner than autocomplete does.
ASO_SEARCH_DELAY_MS=4000

# ---------------------------------------------------------------------------
# Outbound email (optional).
# Alert delivery and the contact form both use nodemailer over SMTP. Without
# both of these set, they report "skipped" rather than failing — so an absent
# alert email is configuration, not a bug.
#   Resend:  smtp://resend:<api-key>@smtp.resend.com:587
#   Brevo:   smtp://<login>:<key>@smtp-relay.brevo.com:587
# ---------------------------------------------------------------------------
EMAIL_SERVER=
EMAIL_FROM=

# ---------------------------------------------------------------------------
# Jobs
# ---------------------------------------------------------------------------
# Shared secret for POST /api/cron (Vercel Cron, GH Actions, k8s CronJob).
CRON_SECRET=
# Set to false on the web dyno when you run a dedicated worker process.
RUN_INLINE_WORKER=false
